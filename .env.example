NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-secret

# Used only by the one-time production seed command.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password

# S3-compatible object storage (Cloudflare R2, Amazon S3, or compatible provider).
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=forth-architecture
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_PUBLIC_PREFIX=public
S3_PRIVATE_PREFIX=objects