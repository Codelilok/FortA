NODE_ENV=development
PORT=8080
# Use the pooled connection string from Neon (include sslmode=require).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret

# Used only by the one-time production seed command.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudinary image storage. Keep the API secret in deployment secrets.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_FOLDER=forth-architecture